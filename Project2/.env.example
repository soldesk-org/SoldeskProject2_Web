DB_URL=jdbc:mariadb://HOST:3306/DB_NAME
DB_USERNAME=
DB_PASSWORD=

# Daum 메일 SMTP (application.yml: smtp.daum.net:465, SSL). 2026-07-18부로 Gmail에서 교체됨.
# MAIL_USERNAME은 Daum 계정 설정 화면의 "아이디" 값(도메인 없이, 예: eattyway) — 실제 이메일 주소를 넣으면 인증 실패함.
# MAIL_APP_PASSWORD는 Daum 마이페이지 > 계정 보안 > 앱 비밀번호에서 발급.
MAIL_USERNAME=
MAIL_APP_PASSWORD=
# 메일 From 헤더에 표시할 실제 주소(위 MAIL_USERNAME과 다름). 생략 시 기본값(eattyway@daum.net) 사용.
MAIL_FROM_ADDRESS=

JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=14
# 로그인 상태 유지 체크박스를 끈 경우(또는 생략 시) 적용되는 짧은 세션. 생략 시 기본값(24) 사용.
JWT_REFRESH_EXPIRATION_HOURS_SHORT=

# 아래 두 값은 생략 시 기본값(24시간 / 매시 정각)으로 동작합니다.
MEMBER_CLEANUP_UNVERIFIED_AFTER_HOURS=24
MEMBER_CLEANUP_CRON=0 0 * * * *

# 팀 공용 Redis (Azure VM, docs/00.공통/Redis-Docker-구축-가이드.md 참고)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# 전화번호 양방향 암호화(AES-256-GCM)/조회용 해시(HMAC-SHA256) 키. 둘 다 256비트 랜덤 값을 Base64로.
# 생성 예시: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHONE_AES_KEY=
PHONE_HASH_KEY=

# 비밀번호 재설정 메일에 담을 프론트엔드 재설정 페이지 URL. 생략 시 기본값(http://localhost:5173/reset-password) 사용.
# 프론트 개발 서버 주소가 정해지면 채워넣기.
PASSWORD_RESET_FRONTEND_URL=

# 뿌리오(Ppurio) SMS 본인인증 연동 (docs/00.공통/SMS-인증-Ppurio-연동-가이드.md 참고)
# ACCOUNT/AUTH_KEY는 뿌리오 콘솔 "연동개발(API)" 메뉴에서 발급받는 값(AUTH_KEY는 계정 비밀번호가 아님).
# 비워두면 SMS 발송 시도 시 토큰 발급부터 실패함. 발급 전 연동IP 등록도 선행되어야 함.
PPURIO_ACCOUNT=
PPURIO_AUTH_KEY=
# 생략 시 기본값(07052364828, 070-5236-4828) 사용
PPURIO_SENDER_NUMBER=

# 로컬 SMS 테스트 모드 (2026-08-04 추가) — true면 실제 SMS 발송 없이 인증번호가 항상 000000으로 고정됨.
# 각자 로컬에서만 켜서 쓰는 opt-in 설정, 팀 공용 .env에는 켜두지 않는다.
SMS_TEST_MODE_ENABLED=false

# 사업자등록증명원 OCR/원본확인/진위확인 Python(FastAPI) 서버 주소. 별도 저장소(receipt-biz-verify)를
# uvicorn으로 직접 기동해야 하며, 이 프로젝트 서버와는 별개 프로세스다. 생략 시 기본값(http://localhost:8000) 사용.
BUSINESS_VERIFY_BASE_URL=
BUSINESS_VERIFY_INTERNAL_TOKEN=

# AI 추천 FastAPI 서버 주소와 Java/Python 내부 호출에 함께 사용할 공유 토큰.
RECOMMENDATION_BASE_URL=
RECOMMENDATION_INTERNAL_TOKEN=

# 소셜로그인(카카오/네이버/구글, docs/06.소셜로그인 참고). client-id/secret은 각 플랫폼 개발자 콘솔에서 발급.
# REDIRECT_URI는 그 콘솔에 등록한 콜백 URL과 정확히 일치해야 하며, 생략 시 기본값(http://localhost:8081/oauth/{provider}) 사용.
# 카카오 CLIENT_SECRET은 콘솔의 "카카오 로그인 > 보안" 메뉴에서 클라이언트 시크릿이 활성화(ON)된 경우에만 필요.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 소셜로그인 콜백 처리 후 리다이렉트할 프론트 주소(2026-07-21 추가). 실제 프론트 주소가 정해지기 전까지는
# 생략 시 기본값(지도 테스트 페이지, http://localhost:8081/tmp-map-test.html)으로 동작.
OAUTH_FRONTEND_REDIRECT_URL=

# Azure Blob Storage 마이그레이션(2026-08-18 추가, 2026-08-18 2차 수정) — 아래 프로필/음식점/영수증/
# 리뷰 이미지 업로드가 로컬 디스크 대신 Azure Blob Storage에 저장하도록 전환하는 옵션.
# IMAGE_STORAGE_BACKEND를 생략하거나 local로 두면 지금까지와 완전히 동일하게 로컬 디스크(각
# *_UPLOAD_DIR/*_BASE_URL)에 저장한다 — 팀이 실제로 전환을 확정하기 전까지 안전한 기본값.
# azure-blob으로 켜려면 AZURE_STORAGE_ACCOUNT_URL이 필요하다(형식: https://{계정명}.blob.core.windows.net).
# ⚠️ 처음엔 연결 문자열(계정 키) 방식으로 만들었었는데, 이 프로젝트가 쓰는 Azure 구독(크레딧/스폰서)에
# "로컬 인증(계정 키/SAS) 금지, Azure AD만 허용" 정책이 걸려있어서 실제로는 전부 거부당했다(스토리지
# 계정 자체의 "키 액세스 허용" 토글은 켜져 있어도 소용없었음 — 실측 확인). 그래서 VM의 시스템 관리 ID
# (Managed Identity)로 인증하는 방식으로 전환 — VM에 관리 ID를 켜고 스토리지 계정에 "Storage Blob
# Data Contributor" 역할을 그 ID에 할당해둬야 동작한다(자세한 절차는
# docs/00.공통/인프라/Azure-Blob-Storage-이미지저장-가이드.md 참고). 계정 키 자체가 필요 없어져서
# 이 방식이 더 안전하기도 하다. 컨테이너 이름(profile-images/restaurant-images/receipt-images/
# review-images)은 코드에 고정돼 있어 따로 설정할 필요 없음(없으면 첫 업로드 때 자동 생성).
# AZURE_STORAGE_ACCOUNT_URL이 비어있으면 azure-blob으로 켜져 있어도 서버는 정상 기동하고, 실제
# 업로드/삭제가 호출되는 순간에만 에러가 난다(다른 선택적 외부 연동과 동일한 원칙). azure-blob으로
# 전환한 뒤에도 과거에 로컬 디스크에 저장됐던 이미지 URL(baseUrl로 시작)은 계속 정상 서빙/삭제된다 —
# 삭제 판별 시 로컬 baseUrl을 항상 우선 확인하기 때문(StaticResourceConfig의 정적 서빙 매핑도 그대로 유지됨).
# 참고: ManagedIdentityCredential은 실제 Azure VM 위에서만 동작하므로, 로컬 개발 PC에서는 이 기능을
# 쓸 수 없다(로컬은 계속 IMAGE_STORAGE_BACKEND=local로 두면 됨 — 기본값이라 아무것도 안 해도 됨).
IMAGE_STORAGE_BACKEND=
AZURE_STORAGE_ACCOUNT_URL=

# 프로필 사진(회원가입/회원정보수정/소셜로그인 공통, docs/05.회원정보수정 참고). 클라우드 스토리지 없이
# 로컬 디스크에 저장 + 정적 서빙하는 방식(IMAGE_STORAGE_BACKEND=local일 때) — 전부 생략 시 기본값
# (./uploads/profile-images, http://localhost:8081/profile-images, 5MB)으로 동작.
PROFILE_IMAGE_UPLOAD_DIR=
PROFILE_IMAGE_BASE_URL=
# 사진 미등록 회원에게 보여줄 기본 이미지 URL. 실제 자산이 정해지기 전까지는 비워두면 profileImageUrl이 null로 내려감.
PROFILE_IMAGE_DEFAULT_URL=
PROFILE_IMAGE_MAX_SIZE_BYTES=

# 음식점(07) 사진 미등록 시 보여줄 기본 이미지 URL(2026-07-20 추가). 사업자가 직접 등록하지 않은
# 음식점에는 항상 이 기본값이 쓰임 — 실제 자산이 정해지기 전까지는 비워두면 imageUrl이 null로 내려감.
RESTAURANT_DEFAULT_IMAGE_URL=

# 음식점(07) 사업자 등록 사진 업로드(2026-07-20 추가) — profile-image와 같은 로컬 디스크 저장 패턴.
# 전부 생략 시 기본값(./uploads/restaurant-images, http://localhost:8081/restaurant-images, 5MB)으로 동작.
RESTAURANT_IMAGE_UPLOAD_DIR=
RESTAURANT_IMAGE_BASE_URL=
RESTAURANT_IMAGE_MAX_SIZE_BYTES=

# 지도 뷰포트 기준 대량 동기화(POST /api/restaurants/sync-area, 2026-07-21 카카오 로컬 API로 전환)는
# 별도 키 없이 위 KAKAO_CLIENT_ID(카카오 로그인과 같은 앱의 REST API 키)를 그대로 재사용한다 —
# 카카오 개발자 콘솔에서 해당 앱의 "제품 설정 > 카카오맵" 사용 설정이 켜져 있어야 한다.

# 영수증 이미지(08 영수증OCR, 2026-07-21 추가) — profile-image/restaurant-image와 같은 로컬 디스크 저장
# 패턴. 전부 생략 시 기본값(./uploads/receipt-images, http://localhost:8081/receipt-images, 5MB)으로 동작.
RECEIPT_IMAGE_UPLOAD_DIR=
RECEIPT_IMAGE_BASE_URL=
RECEIPT_IMAGE_MAX_SIZE_BYTES=

# HTTPS 로컬/팀 테스트용 추가 커넥터(13.HTTPS-전송암호화, 2026-07-23 추가) — 기존 HTTP(8081)는 그대로 두고
# 같은 서버에 TLS 커넥터를 하나 더 연다. 기본값은 꺼져있음(HTTPS_CONNECTOR_ENABLED 생략 시 false) — 켜려면
# 먼저 로컬에서 keystore를 직접 생성해야 한다(docs/13.HTTPS-전송암호화/001-04 참고, keytool 명령 한 줄).
# keystore 파일은 git에 커밋되지 않으므로(개인키) 팀원마다 각자 생성해야 함.
HTTPS_CONNECTOR_ENABLED=
HTTPS_CONNECTOR_PORT=
SSL_KEY_STORE=
SSL_KEY_STORE_PASSWORD=
SSL_KEY_STORE_TYPE=
SSL_KEY_ALIAS=

# 인근 유료주차장 정보(15.주차장-정보, 2026-07-23 추가) — 공공데이터포털 "한국교통안전공단_주차정보
# 제공 API"(활용신청 심의승인 필요, https://www.data.go.kr/data/15099883/openapi.do). 생략 시 기본값
# (http://apis.data.go.kr/B553881/Parking)으로 동작하지만, SERVICE_KEY가 없으면 관리자 동기화 API가
# PARKING_DATA_SERVICE_UNAVAILABLE로 응답한다(근처 조회 자체는 에러 없이 빈 배열).
PARKING_DATA_BASE_URL=
PARKING_DATA_SERVICE_KEY=
# 자동 동기화 주기(2차 추가) — 생략 시 기본값(매일 새벽 3시, 페이지당 100건씩 최대 50페이지)으로 동작.
PARKING_DATA_SYNC_CRON=
PARKING_DATA_SYNC_MAX_PAGES=

# AI 고객센터 챗봇(25.AI고객센터챗봇, 2026-07-31 신규) — 네이버클라우드플랫폼 CLOVA Studio HyperCLOVA X.
# https://www.ncloud.com/product/aiService/clovaStudio 에서 앱 생성 후 API 키 발급. 비워두면 챗봇
# API가 SUPPORT_CHAT_SERVICE_UNAVAILABLE로 응답하지만 앱 기동 자체는 정상 진행됨.
HYPERCLOVA_BASE_URL=
HYPERCLOVA_MODEL=
HYPERCLOVA_API_KEY=

# 챗봇 대화 로그 암호화 키(2026-07-31 2차 추가) — phone-crypto와 동일한 AES-256-GCM용 256비트 키를
# Base64로. 생성 예시: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 필수값(PHONE_AES_KEY처럼 생략 시 앱 기동 실패) — 대화 내용을 암호화하지 않고 저장하는 걸 막기 위함.
CHAT_LOG_AES_KEY=
# 로그 파일 경로, 생략 시 기본값(./logs/support-chat.jsonl)
CHAT_LOG_FILE_PATH=
